# CI の job を動かす image。ci/run.sh が各 runner でこのファイルの hash を tag にして build する。
# パッケージは github-runner/setup.sh が host に入れていたものと同じにする
FROM docker.io/library/debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

# picamera2 と chromium は runner の host（Raspberry Pi OS）と同じく Raspberry Pi の apt repository から入れる
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl gpg \
    && curl --fail --silent --show-error --location https://archive.raspberrypi.com/debian/raspberrypi.gpg.key \
        | gpg --dearmor --output /usr/share/keyrings/raspberrypi-archive-keyring.pgp \
    && printf '%s\n' \
        'Types: deb' \
        'URIs: http://archive.raspberrypi.com/debian/' \
        'Suites: trixie' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/raspberrypi-archive-keyring.pgp' \
        > /etc/apt/sources.list.d/raspi.sources \
    && apt-get update \
    && apt-get install --yes \
        chromium \
        git \
        git-lfs \
        libgl1 \
        libglib2.0-0t64 \
        make \
        python3 \
        python3-evdev \
        python3-picamera2 \
        v4l-utils \
    && apt-get install --yes --no-install-recommends kicad \
    && git lfs install --system --skip-repo \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --silent --show-error --location https://astral.sh/uv/0.10.9/install.sh \
    | env UV_UNMANAGED_INSTALL=/usr/local/bin sh
