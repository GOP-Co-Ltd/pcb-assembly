diff --git a/src/Makefile b/src/Makefile
index 90466f6b..47f24a69 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -1,6 +1,9 @@
 # Main code build rules
 
 src-y += sched.c command.c basecmd.c debugcmds.c
+# pcb-assembly の PnP 機の速度指令（src/firmware/pnp-motion から build.sh が写す）
+dirs-y += src/pnp
+src-y += pnp/velocity_stream.c pnp/vs_planner.c
 src-$(CONFIG_HAVE_GPIO) += initial_pins.c gpiocmds.c stepper.c endstop.c \
     trsync.c
 src-$(CONFIG_WANT_ADC) += adccmds.c
diff --git a/src/stepper.c b/src/stepper.c
