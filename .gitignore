# Claude
.claude/settings.local.json
# サブエージェントの隔離用 git worktree（リポジトリ全体の複製が置かれる）。
# 無視しないと `git add -A` でリポジトリの複製が丸ごとコミットに入る
.claude/worktrees/

# Our project
.env

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# WebUI からアップロードされた PCB ファイル
uploads/

# 実機の稼働設定（machine.toml / カメラキャリブ JSON / printer.cfg のシンボリックリンク）。
# WebUI が実測値を書き換えるため、中身ごと追跡対象から外す。
# 機種のテンプレートは deploy/templates/、テストの設定は tests/data/config/。
# 先頭の / はリポジトリルートへの固定。これが無いと tests/data/config/ も無視されてしまう
/config/
